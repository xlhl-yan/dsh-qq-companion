{
  "name": "dsh-qq-companion",
  "version": "0.2.0",
  "private": true,
  "description": "DSH 插件：监听 QQ（OneBot v11 / SnowLuma）消息，唤醒 agent 自主决定是否回复",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
